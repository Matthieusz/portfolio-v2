---
import ArrowRight from "@/icons/ArrowRight.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { button } from "@/components/starwind/button/Button.astro";

const email = "mateusz.irski@gmail.com";
---

<MainLayout>
  <main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col justify-center py-16">
    <div class="border-border bg-card relative overflow-hidden rounded-lg border font-mono p-8 md:p-12">
      <p class="text-muted-foreground text-sm">$ cd <span class="text-primary">{Astro.url.pathname}</span></p>
      <p class="text-error mt-1 text-lg">404: segment not found</p>
      <p class="text-muted-foreground mt-1 text-sm">
        the path you reached doesn't map to anything in this site
      </p>

      <div class="text-muted-foreground mt-8 text-sm">
        <p>$ ls ~/</p>
        <ul class="mt-2 grid gap-1">
          <li>
            <a href="/" class="hover:text-primary transition-colors">~/home</a>
            <span class="text-muted-foreground/70"> · the pitch</span>
          </li>
          <li>
            <a href="/projects" class="hover:text-primary transition-colors">~/projects</a>
            <span class="text-muted-foreground/70"> · everything I've shipped</span>
          </li>
          <li>
            <a href="/blog" class="hover:text-primary transition-colors">~/blog</a>
            <span class="text-muted-foreground/70"> · notes & write-ups</span>
          </li>
          <li>
            <a href="/about" class="hover:text-primary transition-colors">~/about</a>
            <span class="text-muted-foreground/70"> · who I am</span>
          </li>
        </ul>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/" class={button({ variant: "primary", size: "md" })}>
          cd ~/
          <ArrowRight size={18} color="currentColor" />
        </a>
        <a
          href={`mailto:${email}`}
          class="text-muted-foreground hover:text-primary text-sm transition-colors"
        >
          or start a conversation
        </a>
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-16 animate-scanline opacity-20"
        style="background: linear-gradient(to bottom, transparent, color-mix(in oklch, var(--color-primary) 25%, transparent), transparent);"
      >
      </div>
    </div>
  </main>
</MainLayout>