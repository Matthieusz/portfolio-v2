---
import Github from "@/icons/Github.astro";
import Linkedin from "@/icons/Linkedin.astro";
import Mail from "@/icons/Mail.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";
import AboutMePic from "../content/images/me.jpg";

const socialLinks = [
  {
    name: "GitHub",
    url: "https://github.com/Matthieusz",
    icon: Github,
    description: "Check out my code",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/mateusz-irski-61a593248/",
    icon: Linkedin,
    description: "Connect professionally",
  },
];
---

<MainLayout>
  <section class="mx-auto my-12 flex max-w-6xl flex-col items-start gap-8">
    <h1
      class="section-keyline text-4xl font-bold tracking-[-0.02em]"
      style="text-wrap: balance;"
    >
      About me
    </h1>
    <div class="flex w-full flex-col gap-6 md:flex-row md:gap-10">
      <div class="mx-auto md:w-[40%]">
        <Image
          src={AboutMePic}
          alt="Mateusz Irski"
          width={400}
          height={400}
          class="rounded-lg"
        />
      </div>
      <div class="md:w-[60%]">
        <p class="text-lg leading-relaxed">
          Hi! I'm Mateusz, a software developer with a passion for creating
          innovative solutions. I have experience mainly in Typescript and
          various frameworks (recently loving Tanstack Start though), and I
          enjoy working on both frontend and backend projects. When I'm not
          coding you can catch me swimming, reading or playing some games with
          friends.
        </p>
      </div>
    </div>

    <div class="mt-4 w-full">
      <h2
        class="section-keyline mb-6 text-2xl font-bold tracking-[-0.02em]"
      >
        Connect with me
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="border-border hover:border-primary group flex items-center gap-4 rounded-lg border p-4 transition-colors"
            >
              <div class="bg-muted group-hover:bg-primary/10 flex h-12 w-12 items-center justify-center rounded-lg transition-colors">
                <social.icon size={24} color="currentColor" />
              </div>
              <div class="flex flex-col">
                <span class="text-foreground font-semibold">{social.name}</span>
                <span class="text-muted-foreground text-sm">
                  {social.description}
                </span>
              </div>
            </a>
          ))
        }
      </div>

      <div
        class="mt-8 flex flex-col items-center justify-center gap-2 text-sm sm:flex-row"
      >
        <span class="text-muted-foreground">or send me an email at</span>
        <a
          href="mailto:mateusz.irski@gmail.com"
          class="link-underline text-foreground group inline-flex items-center gap-1 font-medium"
        >
          <Mail size={16} color="currentColor" />
          <span>mateusz.irski@gmail.com</span>
        </a>
      </div>
    </div>
  </section>
</MainLayout>