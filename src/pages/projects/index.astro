---
import MainLayout from "@/layouts/MainLayout.astro";
import ProjectBanner from "@/components/ProjectBanner.astro";
import { slugify } from "@/lib/utils";
import { getCollection } from "astro:content";
import Github from "@/icons/Github.astro";
import Link from "@/icons/Link.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<MainLayout>
  <h1
    class="section-keyline mt-12 mb-6 text-4xl font-bold tracking-[-0.02em]"
    style="text-wrap: balance;"
  >
    Projects
  </h1>

  <div class="mt-4 mb-12">
    <div class="mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <article class="bg-card border-border flex h-full flex-col overflow-hidden rounded-lg border">
            <a
              href={`/projects/${slugify(project.data.title)}`}
              class="group block"
            >
              <ProjectBanner
                title={project.data.title}
                id={project.id}
                compact={true}
              />
            </a>
            <div class="flex flex-1 flex-col gap-4 p-4">
              <div class="space-y-2">
                <div class="text-muted-foreground text-xs">
                  <time datetime={project.data.date.toISOString()}>
                    {project.data.date.toLocaleDateString("en-GB")}
                  </time>
                </div>
                <h2
                  class="text-lg font-semibold"
                  transition:name={`project-${project.id}-title`}
                >
                  <a
                    href={`/projects/${slugify(project.data.title)}`}
                    class="hover:text-primary transition-colors"
                  >
                    {project.data.title}
                  </a>
                </h2>
                <p class="text-muted-foreground text-sm leading-relaxed">
                  {project.data.description}
                </p>
              </div>
              <div class="text-muted-foreground mt-auto text-xs leading-relaxed">
                {project.data.tags.join(" · ")}
              </div>
              <div class="flex flex-wrap items-center gap-3 text-sm">
                {project.data.repoLink ? (
                  <a
                    class="link-underline flex items-center gap-1"
                    href={project.data.repoLink}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <Github size={16} color="currentColor" />
                    Repository
                  </a>
                ) : null}
                {project.data.demoLink ? (
                  <a
                    class="link-underline flex items-center gap-1"
                    href={project.data.demoLink}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    <Link size={16} color="currentColor" />
                    Live demo
                  </a>
                ) : null}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="text-muted-foreground text-md text-center">
      + a lot of smaller less significant projects :)
    </p>
  </div>
</MainLayout>
