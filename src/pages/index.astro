---
import Hero from "@/components/Hero.astro";
import LiveFeed from "@/components/LiveFeed.tsx";
import FeaturedWork from "@/components/FeaturedWork.astro";
import Writing from "@/components/Writing.astro";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout>
  <main class="mt-8 md:mt-12">
    <div class="mx-auto max-w-6xl">
      <section
        class="flex flex-col items-center gap-10 6xl:flex-row 6xl:items-start 6xl:justify-between 6xl:gap-16"
      >
        <Hero />
        <div class="w-full max-w-md 6xl:w-[34rem]">
          <LiveFeed client:idle />
        </div>
      </section>

      <section class="mt-20 md:mt-28">
        <h2 class="section-keyline text-3xl font-bold tracking-[-0.02em] md:text-4xl">
          Featured work
        </h2>
        <FeaturedWork />
      </section>

      <section class="mt-20 mb-16 md:mt-28">
        <Writing />
      </section>
    </div>
  </main>
</MainLayout>