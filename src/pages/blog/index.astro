---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<MainLayout>
  <div class="mx-auto mb-12 mt-12 max-w-4xl">
    <h1
      class="section-keyline text-4xl font-bold tracking-[-0.02em]"
      style="text-wrap: balance;"
    >
      Writing
    </h1>
    <p class="text-muted-foreground mt-6 max-w-2xl leading-relaxed">
      Notes, experiments, and write-ups on web development, programming, and
      technology.
    </p>

    <ul class="mt-10 flex flex-col">
      {
        posts.length === 0 ? (
          <li class="text-muted-foreground">No posts published yet.</li>
        ) : (
          posts.map((post) => (
            <li class="border-border border-t">
              <a
                href={`/blog/${post.id}`}
                class="group flex flex-col gap-2 py-6 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              >
                <div class="flex flex-col gap-1">
                  <h2 class="text-xl font-semibold transition-colors">
                    <span class="group-hover:text-primary transition-colors">
                      {post.data.title}
                    </span>
                  </h2>
                  <span class="text-muted-foreground text-sm">
                    {post.data.description}
                  </span>
                </div>
                <div class="text-muted-foreground flex shrink-0 items-center gap-3 text-xs">
                  <time class="tabular-nums" datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("en-GB")}
                  </time>
                  <span aria-hidden="true">{post.data.tags.join(" · ")}</span>
                </div>
              </a>
            </li>
          ))
        )
      }
    </ul>
  </div>
</MainLayout>