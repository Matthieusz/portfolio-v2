---
import ArrowRight from "@/icons/ArrowRight.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// A section with one post reads as "I started a blog once." Hide until there's
// enough to imply a habit. We seed three real posts, so this renders today.
const MIN_POSTS = 3;
const recent = posts.slice(0, 4);
const show = posts.length >= MIN_POSTS;
---

{
 show ? (
  <div>
    <h2 class="section-keyline text-3xl font-bold tracking-[-0.02em] md:text-4xl">
      Writing
    </h2>
    <ul class="mt-8 flex flex-col">
      {recent.map((post) => (
        <li class="border-border border-t">
          <a
            href={`/blog/${post.id}`}
            class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
          >
            <div class="flex items-baseline gap-3">
              <span class="text-muted-foreground text-xs tabular-nums">
                {post.data.date.toLocaleDateString("en-GB")}
              </span>
              <h3 class="text-lg font-semibold">
                <span class="hover:text-primary transition-colors">
                  {post.data.title}
                </span>
              </h3>
            </div>
            <div class="text-muted-foreground flex items-center gap-3 text-xs">
              <span class="truncate sm:max-w-[22rem]">{post.data.description}</span>
              <ArrowRight
                size={16}
                color="currentColor"
                class="shrink-0 transition-transform group-hover:translate-x-1"
              />
            </div>
          </a>
        </li>
      ))}
    </ul>
    <a
      href="/blog"
      class="text-muted-foreground hover:text-primary mt-4 inline-flex items-center gap-1 text-sm transition-colors"
    >
      Read more <ArrowRight size={16} color="currentColor" />
    </a>
  </div>
) : null
}