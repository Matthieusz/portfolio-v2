---
interface Props {
  title: string;
  id: string;
  compact?: boolean;
}

const { title, id, compact = true } = Astro.props;

// Flat pastel covers retain the site's soft palette without competing with the work.
const covers = [
  "oklch(0.8 0.09 255)",
  "oklch(0.84 0.07 230)",
  "oklch(0.86 0.07 180)",
  "oklch(0.86 0.08 145)",
  "oklch(0.85 0.09 65)",
  "oklch(0.83 0.08 25)",
  "oklch(0.88 0.07 110)",
  "oklch(0.85 0.06 15)",
];

const hash = title.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0);
const coverColor = covers[hash % covers.length]!;
---

<div
  class:list={[
    "relative flex w-full items-center justify-center overflow-clip select-none",
    compact ? "h-48" : "h-64",
  ]}
  style={`background-color: ${coverColor}; color: oklch(0.28 0.025 255);`}
  transition:name={`project-${id}-image`}
>
  <!-- Main label -->
  <div class="relative z-10 flex flex-col items-center gap-1.5 px-4 text-center">
    <span
      class="font-mono font-bold tracking-tight"
      style={`font-size: ${compact ? "1.125rem" : "1.5rem"}; line-height: 1.2;`}
    >
      {title}
    </span>
  </div>
</div>
