---
interface Props {
  title: string;
  id: string;
  compact?: boolean;
}

const { title, id, compact = true } = Astro.props;

// One committed brand color: every banner is a pair from the magenta family
// so per-project variety lives inside a single hue lane, not a rainbow.
const gradients: [string, string][] = [
  ["#ff3e9c", "#c026d3"], // magenta → fuchsia
  ["#c026d3", "#a21caf"], // fuchsia → purple
  ["#ff5b8f", "#ff8fa3"], // pink → rose
  ["#ff3e9c", "#f472b6"], // magenta → pink
  ["#a21caf", "#ff3e9c"], // purple → magenta
  ["#f472b6", "#9d174d"], // pink → plum
  ["#ff8fa3", "#c026d3"], // rose → fuchsia
  ["#ec4899", "#be185d"], // pink → dark pink
];

// Deterministic hash from title to pick a gradient
const hash = title
  .split("")
  .reduce((acc, char) => acc + char.charCodeAt(0), 0);
const [fromColor, toColor] = gradients[hash % gradients.length]!;

// Get up to 2 initials from words/segments
const initials = title
  .split(/[\s\-_]+/)
  .map((word) => word[0] ?? "")
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<div
  class:list={[
    "relative flex w-full items-center justify-center overflow-hidden select-none",
    "transition-transform duration-300 group-hover:scale-[1.05]",
    compact ? "h-48" : "h-64",
  ]}
  style={`background: linear-gradient(135deg, ${fromColor}, ${toColor});`}
  transition:name={`project-${id}-image`}
>
  <!-- Dot grid texture -->
  <div
    class="absolute inset-0"
    style="background-image: radial-gradient(circle, rgba(16,16,18,0.22) 1px, transparent 1px); background-size: 20px 20px;"
  ></div>

  <!-- Large faded initials watermark -->
  <span
    class="absolute font-mono font-black leading-none"
    style="font-size: clamp(5rem, 18vw, 9rem); color: rgba(16,16,18,0.10); pointer-events: none;"
    aria-hidden="true"
  >
    {initials}
  </span>

  <!-- Main label -->
  <div class="relative z-10 flex flex-col items-center gap-1.5 px-4 text-center">
    <span
      class="font-mono text-xs tracking-[0.2em] uppercase"
      style="color: rgba(16,16,18,0.55);"
    >
      ~/projects
    </span>
    <span
      class="font-mono font-bold tracking-tight"
      style={`font-size: ${compact ? "1.125rem" : "1.5rem"}; color: rgba(16,16,18,0.9); line-height: 1.2;`}
    >
      {title}
    </span>
  </div>
</div>
