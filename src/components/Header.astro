---
import Download from "@/icons/Download.astro";
import ArrowRight from "@/icons/ArrowRight.astro";
import Poland from "@/icons/Poland.astro";
import England from "@/icons/England.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import {
  Dropdown,
  DropdownTrigger,
  DropdownContent,
  DropdownItem,
} from "../components/starwind/dropdown";

const cvEnglishUrl = "/cv/cv-en.pdf";
const cvPolishUrl = "/cv/cv-pl.pdf";
const email = "mateusz.irski@gmail.com";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
];
---

<header id="site-header" class="sticky top-0 z-2000 backdrop-blur-sm">
  <div
    class="mx-0 flex h-16 max-w-full items-center justify-between p-4 md:mx-auto md:max-w-[80%] md:pt-4"
  >
    <Breadcrumb />

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-6 text-lg lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? "page" : undefined}
            class:list={[
              "rounded px-3 py-2 font-medium transition-colors duration-200 hover:text-primary",
              isActive(link.href)
                ? "text-primary"
                : "text-foreground",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <Dropdown>
        <DropdownTrigger
          asChild
          class="hover:text-primary flex cursor-pointer items-center gap-2 rounded px-3 py-2 font-medium transition-colors duration-200"
        >
          <p class="flex items-center gap-2"><Download size={20} color="currentColor" /> CV</p>
        </DropdownTrigger>
        <DropdownContent align="end">
          <DropdownItem as="a" href={cvPolishUrl} download>
            <Poland /> PL
          </DropdownItem>
          <DropdownItem as="a" href={cvEnglishUrl} download>
            <England /> EN
          </DropdownItem>
        </DropdownContent>
      </Dropdown>
      <a
        href={`mailto:${email}`}
        class="bg-primary text-primary-foreground hover:bg-primary/90 flex items-center gap-1.5 rounded-md px-4 py-2 text-sm font-medium transition-colors"
      >
        Start a conversation
        <ArrowRight size={16} color="currentColor" />
      </a>
    </nav>

    <!-- Mobile menu -->
    <div class="relative lg:hidden">
      <Dropdown>
        <DropdownTrigger
          class="hover:bg-primary/10 hover:text-primary flex h-10 w-10 cursor-pointer items-center justify-center rounded-md transition-colors"
          aria-label="Open menu"
        >
          <span class="sr-only">Open menu</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="18" x2="20" y2="18"></line>
          </svg>
        </DropdownTrigger>
        <DropdownContent align="end">
          {
            navLinks.map((link) => (
              <DropdownItem as="a" href={link.href}>
                {link.label}
              </DropdownItem>
            ))
          }
          <DropdownItem as="a" href={cvPolishUrl} download>
            <Poland /> CV (PL)
          </DropdownItem>
          <DropdownItem as="a" href={cvEnglishUrl} download>
            <England /> CV (EN)
          </DropdownItem>
          <DropdownItem as="a" href={`mailto:${email}`} class="text-primary">
            <ArrowRight size={16} color="currentColor" /> Start a conversation
          </DropdownItem>
        </DropdownContent>
      </Dropdown>
    </div>
  </div>
</header>