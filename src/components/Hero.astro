---
import ArrowRight from "@/icons/ArrowRight.astro";
import Github from "@/icons/Github.astro";
import Linkedin from "@/icons/Linkedin.astro";
---

<div class="hero-intro">
  <h1 class="hero-heading font-bold">
    Hey! I'm <span class="text-primary inline-block">Mateusz Irski</span>
  </h1>
  <p class="hero-description max-w-prose text-lg leading-relaxed">
    I am currently studying at{" "}
    <a
      href="https://www.put.poznan.pl/en/"
      class="hero-university"
      target="_blank"
      rel="noopener noreferrer"
    >
      Poznań University of Technology
    </a>
    . I've written software that solved real problems, really well. Let's build
    something amazing together!
  </p>
  <nav
    class="hero-links text-muted-foreground text-sm"
    aria-label="More about Mateusz"
  >
    <div class="hero-socials">
      <a
        href="https://github.com/Matthieusz"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-link"
      >
        <span class="hero-icon" aria-hidden="true">
          <Github size={20} color="currentColor" />
        </span>
        Github
      </a>

      <span class="hero-divider" aria-hidden="true"></span>

      <a
        href="https://www.linkedin.com/in/mateusz-irski-61a593248/"
        target="_blank"
        rel="noopener noreferrer"
        class="hero-link"
      >
        <span class="hero-icon" aria-hidden="true">
          <Linkedin size={20} color="currentColor" />
        </span>
        LinkedIn
      </a>
    </div>

    <a href="/about" class="hero-link hero-about text-primary">
      More about me
      <span class="hero-icon" aria-hidden="true">
        <ArrowRight size={16} color="currentColor" />
      </span>
    </a>
  </nav>
</div>

<style>
  .hero-intro {
    min-inline-size: 0;
  }

  .hero-heading {
    font-size: clamp(1.875rem, 2.5vw, 2.25rem);
    line-height: 1.25;
  }

  .hero-description {
    margin-block-start: 1rem;
  }

  .hero-university {
    text-decoration: underline dashed var(--primary);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 2rem;
    margin-block-start: 1.5rem;
  }

  .hero-socials {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-divider {
    inline-size: 1px;
    block-size: 1rem;
    background-color: var(--border);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-block-size: 2.75rem;
    white-space: nowrap;
  }

  .hero-icon {
    display: inline-flex;
    flex: none;
  }

  .hero-icon :global(svg) {
    inline-size: 1.25em;
    block-size: 1.25em;
  }

  .hero-intro a {
    border-radius: var(--radius-xs);
    transition:
      color 160ms ease-out,
      background-color 160ms ease-out;
  }

  .hero-intro a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .hero-intro a:active {
    color: var(--primary-foreground);
    background-color: var(--primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-link:hover {
      color: var(--primary);
    }

    .hero-about:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }

    .hero-university:hover {
      color: var(--primary-foreground);
      background-color: var(--primary);
    }
  }
</style>
