---
import ArrowRight from "@/icons/ArrowRight.astro";
import Github from "@/icons/Github.astro";
import Linkedin from "@/icons/Linkedin.astro";
import { button } from "./starwind/button/Button.astro";

const email = "mateusz.irski@gmail.com";
---

<div class="flex flex-col gap-6">
  <div>
    <p class="text-muted-foreground mb-3 text-sm">$ whoami</p>
    <h1
      class="text-4xl font-bold tracking-[-0.03em] md:text-5xl"
      style="text-wrap: balance;"
    >
      Mateusz Irski
      <span class="text-primary"> —</span>
      <span class="text-muted-foreground font-medium">software engineer</span>
    </h1>
  </div>

  <p
    class="max-w-prose text-lg leading-relaxed"
    style="text-wrap: pretty;"
  >
    Studying at Poznań University of Technology. I ship full-stack TypeScript
    that runs in the real world — a live clan-management dashboard used daily
    by a Margonem guild, a real-time lab-group platform with 260+ automated
    tests, and a local-first squad builder.
    <a
      href="/about"
      class="link-underline">More about me</a
    >.
  </p>

  <div class="flex flex-wrap items-center gap-3">
    <a href={`mailto:${email}`} class={button({ variant: "primary", size: "lg" })}>
      Start a conversation
      <ArrowRight size={18} color="currentColor" />
    </a>
    <div class="text-muted-foreground flex items-center gap-3">
      <a
        href="https://github.com/Matthieusz"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-foreground transition-colors duration-200"
        aria-label="GitHub">
        <Github size={20} color="currentColor" />
      </a>
      <span aria-hidden="true" class="text-muted-foreground/70">·</span>
      <a
        href="https://www.linkedin.com/in/mateusz-irski-61a593248/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-foreground transition-colors duration-200"
        aria-label="LinkedIn">
        <Linkedin size={20} color="currentColor" />
      </a>
    </div>
  </div>
</div>